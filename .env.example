# Copy to .env and fill local values. Never commit .env.
# Used from Phase 1 / Step 3 onward.

POSTGRES_USER=consultorios
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=consultorios
POSTGRES_PORT=5432

# JWT signing key must be at least 32 characters. Required from Step 4.
JWT_SIGNING_KEY=

# Demo users (Development seed only). Never use real people or production passwords.
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_PROFESIONAL=
DEMO_PASSWORD_RECEPTION=
